# ==============================================================================
# 生产环境配置示例
# ==============================================================================
# 复制此文件为 .env 并修改以下配置

# ==============================================================================
# Django 配置
# ==============================================================================
DJANGO_SECRET_KEY=your-production-secret-key-here-keep-it-safe
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ==============================================================================
# 数据库配置
# ==============================================================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=production_db_name
DB_USER=production_db_user
DB_PASSWORD=your-strong-database-password
DB_HOST=localhost
DB_PORT=3306

# ==============================================================================
# 服务器配置
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
SERVER_THREADS=32
SERVER_MAX_CONNECTIONS=1000
SERVER_BACKLOG=2048
SERVER_TIMEOUT=120

# 对外访问端口（nginx 监听端口，默认 8090）
# nginx 转发时 Host 头不带端口，榜单分享图的二维码/链接需要它才能扫得开；
# 若对外走 80/443（域名直连），设为空字符串。
PUBLIC_SITE_PORT=8090

# ==============================================================================
# 会员支付配置（支付宝电脑网站支付）
# ==============================================================================
# 正式应用 APPID（open.alipay.com 创建应用并签约「电脑网站支付」）
ALIPAY_APPID=your-production-appid
# 正式环境必须为 False
ALIPAY_SANDBOX=False
# 网关留空则按上面的开关自动选择（正式环境为 https://openapi.alipay.com/gateway.do）
ALIPAY_GATEWAY=
# RSA2 密钥文件路径，留空则读取 keys/app_private_key.pem 与 keys/alipay_public_key.pem
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# 支付完成后跳回本站的地址（必须是公网可访问的 https 地址）
ALIPAY_RETURN_URL=https://your-domain.com/quiz/membership/alipay/return/
# 支付宝异步通知地址（必须是公网可访问的 https 地址）
ALIPAY_NOTIFY_URL=https://your-domain.com/quiz/membership/alipay/notify/

# 订单支付超时时间（分钟）
ORDER_TIMEOUT_MINUTES=30
# 支付页兜底查单的最小订单账龄（秒）
ORDER_SYNC_MIN_AGE_SECONDS=60