{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'Build complete'",
    "nixpacks": {
      "providers": {
        "python": {
          "version": "3.10"
        }
      }
    }
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "startCommand": "python manage.py collectstatic --noinput && python manage.py migrate && waitress-serve --port=$PORT need_to_do.wsgi:application",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
